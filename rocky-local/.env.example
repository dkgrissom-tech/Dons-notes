# ---- speech to text (always local) ----
# preflight.py prints the right values for your machine
STT_MODEL=small.en
STT_DEVICE=cpu
STT_COMPUTE=int8
STT_LANGUAGE=en

# ---- text to speech ----
# piper = fully local (default) | elevenlabs = cloud, sends reply TEXT out
TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ---- push to talk ----
HOTKEY=ctrl_r
MIN_HOLD_MS=250
MAX_RECORD_S=60

# ---- audio devices: blank = system default, or index/name substring ----
INPUT_DEVICE=
OUTPUT_DEVICE=

# ---- claude code ----
CLAUDE_BIN=claude
# the project directory Claude Code operates in
CLAUDE_CWD=
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob,Bash,Edit,Write
CLAUDE_TIMEOUT=300
PERSIST_SESSION=1
