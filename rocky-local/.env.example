# ---- speech to text (always local) ----
# preflight.py prints the right values for your machine
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE=int8
STT_LANGUAGE=en

# ---- text to speech ----
# piper = fully local (default) | elevenlabs = cloud, sends reply TEXT out
TTS_BACKEND=piper
PIPER_VOICE=en_US-lessac-medium
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ---- voice activation (no hotkey needed) ----
VAD_THRESHOLD=0.02
VAD_SILENCE_MS=800
MIN_HOLD_MS=250
MAX_RECORD_S=60

# ---- audio devices: blank = system default, or index/name substring ----
INPUT_DEVICE=
OUTPUT_DEVICE=

# ---- claude code ----
CLAUDE_BIN=claude
# the project directory Claude Code operates in
CLAUDE_CWD=
CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob,Bash,Edit,Write
CLAUDE_TIMEOUT=300
PERSIST_SESSION=1
# blank = Claude Code default (Sonnet). haiku alias is much faster for voice replies.
CLAUDE_MODEL=
# blank = ask for approval on tool calls (which fails/denies in headless voice mode,
# wasting a retry turn every time). bypassPermissions lets CLAUDE_ALLOWED_TOOLS above
# actually run without asking -- that's the real gate on what Rocky can touch.
CLAUDE_PERMISSION_MODE=
